# --- Required ---
VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com

# --- TURN server for reliable calling (optional) ---
# Without these, HelloChat falls back to a free public TURN relay
# (openrelay.metered.ca) so calls work out of the box. That relay is
# shared/rate-limited community infrastructure - fine to ship with, but
# for production-grade call reliability at real scale, set up your own
# TURN server (Twilio Network Traversal Service, Metered.ca paid plan,
# Xirsys, or self-hosted coturn) and set these:
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
