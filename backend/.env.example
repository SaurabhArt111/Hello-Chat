# --- Required ---
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=a_long_random_secret_string
PORT=5000
NODE_ENV=production

# The deployed frontend origin(s), comma-separated if more than one. Used
# for CORS. Example: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Uploads (avatars, group logos, chat media) are stored on local disk under
# backend/uploads and served from /uploads - no external storage API is used.
# NOTE: on Render's free/standard tiers the filesystem is ephemeral, so files
# in backend/uploads are wiped on every deploy/restart unless you attach a
# persistent disk to the service.

# --- Web Push / VAPID (optional but recommended - see backend/src/utils/webPush.js) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Translation (existing feature) ---
# Uses @vitalets/google-translate-api (keyless, no signup) - no config needed.

# --- Admin bootstrap (optional - existing feature) ---
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Debug (optional) ---
DEBUG_SOCKET_LOGS=false
